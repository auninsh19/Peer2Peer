-- Create the PeerEvaluations table to store average scores
CREATE TABLE PeerEvaluations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    group_id INTEGER NOT NULL,
    assignment_id INTEGER NOT NULL,
    Pavg FLOAT,
    Lavg FLOAT,
    Cavg FLOAT,
    TMavg FLOAT,
    CommAvg FLOAT,
    PSavg FLOAT,
    FOREIGN KEY (group_id) REFERENCES Groups(id),
    FOREIGN KEY (assignment_id) REFERENCES Assignments(id)
);

-- Create the ParticipationEvaluations table to store individual scores for participation
CREATE TABLE ParticipationEvaluations (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    evaluation_id INTEGER NOT NULL,
    evaluator_id INTEGER NOT NULL,
    evaluatee_id INTEGER NOT NULL,
    P1 FLOAT,
    P2 FLOAT,
    P3 FLOAT,
    P4 FLOAT,
    FOREIGN KEY (evaluation_id) REFERENCES PeerEvaluations(id),
    FOREIGN KEY (evaluator_id) REFERENCES User(id),
    FOREIGN KEY (evaluatee_id) REFERENCES User(id)
);

